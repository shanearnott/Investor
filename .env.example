# REQUIRED — Auth.js (NextAuth) cookie/JWT signing secret.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-string

# OPTIONAL — Google OAuth client (only needed for Drive sync).
# Leave both blank to deploy in demo-only mode (data stored in browser localStorage).
#
# To enable Drive sync, create credentials at:
#   https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID, type "Web application".
# Authorized redirect URI:
#   https://<your-vercel-domain>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (for local dev)
# OAuth consent scope:
#   https://www.googleapis.com/auth/drive.file
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OPTIONAL — public URL override. Vercel sets VERCEL_URL automatically.
# AUTH_URL=https://your-domain.com
