# Auth.js (NextAuth) base secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-string

# Google OAuth client (create one at https://console.cloud.google.com/apis/credentials)
# OAuth 2.0 Client ID, type "Web application"
# Authorized redirect URI:   https://<your-vercel-domain>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# When deployed, set to your public URL (Vercel sets VERCEL_URL automatically;
# Auth.js v5 will pick that up). Set explicitly if running custom-domain or non-Vercel.
# AUTH_URL=https://your-domain.com
